package ui

import (
	"strconv"
)

// Practice renders the words to type as a fragment swapped into #words by htmx.
// The client engine reads the words from the DOM and the level/lang/count and the
// dead-key hints for accented characters (data-accents) from the data
// attributes.
templ Practice(words []string, level int, lang string, count int, accents string) {
	<div id="words" data-level={ strconv.Itoa(level) } data-lang={ lang } data-count={ strconv.Itoa(count) } data-accents={ accents }>
		<div class="words-row">
			for _, w := range words {
				<span class="word">
					for _, c := range w {
						<span class="char">{ string(c) }</span>
					}
				</span>
			}
		</div>
	</div>
}
