package ui

import (
	"strconv"

	"github.com/wfrs-dev/ldvdt/internal/domain"
)

// Page renders the full SPA shell in three stacked rows (S8): the practice
// controls on top, the words and keyboard in the middle, and the progress panel
// (aggregate stats plus the chart) at the bottom.
templ Page(kb domain.Keyboard, levels []domain.Level, stats domain.Stats, series string) {
	<!DOCTYPE html>
	<html lang="es" data-theme="dark">
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>ldvdt · entrenador de layout</title>
		<script>
			// Apply the saved theme before first paint to avoid flashing the
			// wrong theme (S20). The server-rendered attribute is the single
			// source of the default, so it is never duplicated here.
			(function () {
				try {
					var el = document.documentElement;
					var theme = localStorage.getItem("ldvdt-theme");
					if (theme !== "light" && theme !== "dark") {
						theme = el.getAttribute("data-theme") || "dark";
					}
					el.setAttribute("data-theme", theme);
				} catch (e) {}
			})();
		</script>
		<script src="/static/vendor/htmx.min.js"></script>
		<script src="/static/vendor/chart.umd.js"></script>
		<link rel="stylesheet" href="/static/app.css"/>
		<script defer src="/static/app.js"></script>
	</head>
	<body>
		<div class="app">
			<section class="panel panel-controls">
				@Controls(levels)
				<button type="button" id="theme-toggle" aria-label="Cambiar a tema claro">Tema claro</button>
			</section>
			<main class="panel panel-center">
				<div id="words">
					<p class="hint">Elegí nivel, idioma y cantidad, y tocá <strong>Empezar</strong>.</p>
				</div>
				@Keyboard(kb)
			</main>
			<section class="panel panel-progress" id="progress-panel">
				@Progress(stats, series)
			</section>
		</div>
	</body>
	</html>
}

// Controls renders the practice configuration form (level, language, count).
templ Controls(levels []domain.Level) {
	<form id="controls" class="controls" hx-get="/practice" hx-target="#words" hx-swap="outerHTML">
		<label for="level">Nivel</label>
		<select name="level" id="level">
			for _, l := range levels {
				<option value={ strconv.Itoa(l.Number) }>{ strconv.Itoa(l.Number) } · { l.Name }</option>
			}
		</select>

		<label for="lang">Idioma</label>
		<select name="lang" id="lang">
			<option value="es">Español</option>
			<option value="en">English</option>
		</select>

		<label for="count">Palabras</label>
		<input type="number" name="count" id="count" min="20" value="20"/>

		<button type="submit">Empezar</button>
	</form>
}

// Progress renders the user's aggregate progress (S11) and the chart series
// (S4). The series travels as JSON on the canvas so the client can rebuild the
// Chart.js instance after an htmx swap.
templ Progress(stats domain.Stats, series string) {
	<h2>Progreso</h2>
	<dl class="stats">
		<dt>Prácticas</dt>
		<dd>{ strconv.Itoa(stats.TotalPractices) }</dd>
		<dt>Tiempo total</dt>
		<dd>{ formatDuration(stats.TotalTimeMS) }</dd>
		<dt>Mejor WPM</dt>
		<dd>{ f1(stats.BestWPM) }</dd>
		<dt>WPM promedio</dt>
		<dd>{ f1(stats.AvgWPM) }</dd>
		<dt>Precisión</dt>
		<dd>{ pct(stats.AvgAccuracy) }</dd>
		<dt>Consistencia</dt>
		<dd>{ f1(stats.AvgConsistency) } ms</dd>
	</dl>
	<div class="chart-box">
		<canvas id="progress-chart" data-series={ series }></canvas>
	</div>
}
