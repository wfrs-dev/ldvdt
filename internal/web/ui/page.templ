package ui

import (
	"strconv"

	"github.com/wfrs-dev/ldvdt/internal/domain"
)

// Page renders the full SPA shell (S22): a single Bootstrap .container holding
// three stacked rows — the practice controls on top, the words and keyboard in
// the middle, and the progress panel (aggregate stats plus the chart) at the
// bottom.
templ Page(kb domain.Keyboard, levels []domain.Level, stats domain.Stats, series string) {
	<!DOCTYPE html>
	<html lang="es" data-bs-theme="dark">
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>ldvdt · entrenador de layout</title>
		<script>
			// Apply the saved theme before first paint to avoid flashing the
			// wrong theme (S20, S24). data-bs-theme is Bootstrap 5.3's own theme
			// attribute, so the components switch with the palette. The
			// server-rendered attribute is the single source of the default, so
			// it is never duplicated here.
			(function () {
				try {
					var el = document.documentElement;
					var theme = localStorage.getItem("ldvdt-theme");
					if (theme !== "light" && theme !== "dark") {
						theme = el.getAttribute("data-bs-theme") || "dark";
					}
					el.setAttribute("data-bs-theme", theme);
				} catch (e) {}
			})();
		</script>
		<script src="/static/vendor/htmx.min.js"></script>
		<script src="/static/vendor/chart.umd.js"></script>
		<link rel="stylesheet" href="/static/vendor/bootstrap.min.css"/>
		<link rel="stylesheet" href="/static/app.css"/>
		<script defer src="/static/app.js"></script>
	</head>
	<body>
		<div class="container py-3">
			<section class="row g-2 align-items-center" id="controls-row">
				<div class="col-12 col-xl-9">
					@Controls(levels)
				</div>
				<div class="col-12 col-xl-3 text-xl-end">
					<button type="button" id="theme-toggle" class="btn btn-outline-secondary" aria-label="Cambiar a tema claro">Tema claro</button>
				</div>
			</section>
			<main class="row g-3" id="practice-row">
				<div class="col-12">
					<div id="words">
						<p class="hint">Elegí nivel, idioma y cantidad, y tocá <strong>Empezar</strong>.</p>
					</div>
				</div>
				<div class="col-12">
					@Keyboard(kb)
				</div>
			</main>
			<section class="row g-3" id="progress-panel">
				@Progress(stats, series)
			</section>
		</div>
	</body>
	</html>
}

// Controls renders the practice configuration form (level, language, count).
templ Controls(levels []domain.Level) {
	<form id="controls" class="row row-cols-auto g-2 align-items-end" hx-get="/practice" hx-target="#words" hx-swap="outerHTML">
		<div class="col">
			<label class="form-label" for="level">Nivel</label>
			<select class="form-select" name="level" id="level">
				for _, l := range levels {
					<option value={ strconv.Itoa(l.Number) }>{ strconv.Itoa(l.Number) } · { l.Name }</option>
				}
			</select>
		</div>
		<div class="col">
			<label class="form-label" for="lang">Idioma</label>
			<select class="form-select" name="lang" id="lang">
				<option value="es">Español</option>
				<option value="en">English</option>
			</select>
		</div>
		<div class="col">
			<label class="form-label" for="count">Palabras</label>
			<input class="form-control" type="number" name="count" id="count" min="20" value="20"/>
		</div>
		<div class="col">
			<button class="btn btn-primary" type="submit">Empezar</button>
		</div>
	</form>
}

// Progress renders the user's aggregate progress (S11) and the chart series
// (S4). The series travels as JSON on the canvas so the client can rebuild the
// Chart.js instance after an htmx swap.
templ Progress(stats domain.Stats, series string) {
	<div class="col-12">
		<h2 class="mb-0">Progreso</h2>
	</div>
	<div class="col-12 col-md-5 col-xl-4">
		<dl class="row mb-0">
			<dt class="col-7 fw-bold fst-italic text-body-secondary">Prácticas</dt>
			<dd class="col-5 text-end stat-value">{ strconv.Itoa(stats.TotalPractices) }</dd>
			<dt class="col-7 fw-bold fst-italic text-body-secondary">Tiempo total</dt>
			<dd class="col-5 text-end stat-value">{ formatDuration(stats.TotalTimeMS) }</dd>
			<dt class="col-7 fw-bold fst-italic text-body-secondary">Mejor WPM</dt>
			<dd class="col-5 text-end stat-value">{ f1(stats.BestWPM) }</dd>
			<dt class="col-7 fw-bold fst-italic text-body-secondary">WPM promedio</dt>
			<dd class="col-5 text-end stat-value">{ f1(stats.AvgWPM) }</dd>
			<dt class="col-7 fw-bold fst-italic text-body-secondary">Precisión</dt>
			<dd class="col-5 text-end stat-value">{ pct(stats.AvgAccuracy) }</dd>
			<dt class="col-7 fw-bold fst-italic text-body-secondary">Consistencia</dt>
			<dd class="col-5 text-end stat-value">{ f1(stats.AvgConsistency) } ms</dd>
		</dl>
	</div>
	<div class="col-12 col-md-7 col-xl-8">
		<div class="chart-box">
			<canvas id="progress-chart" data-series={ series }></canvas>
		</div>
	</div>
}
